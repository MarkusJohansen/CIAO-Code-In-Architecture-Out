# ============================================================
# CIAO Project — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# uv lock file (uncomment if you do NOT want to commit it)
uv.lock

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Secrets
.env
.env.*
!.env.example

# Generated by CIAO runs
full_code.txt
arc42_documentation.txt
documentation.txt
*.log

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data folder — generated markdown docs (keep other data)
Data/Repos/*.md
