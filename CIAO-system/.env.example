# ============================================================
# CIAO LLM Configuration
# ============================================================

# --- Option A: OpenAI Cloud (default if LLM_BASE_URL is not set) ---
# Uncomment and fill in if you want to use OpenAI directly:
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Option B: Self-hosted models (Ollama / llama.cpp) ---
# Uncomment ONE of the blocks below depending on your setup.

# -- Ollama (default local endpoint) --
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:70b
# LLM_API_KEY is optional for Ollama; leave blank or set to any string
# LLM_API_KEY=

# -- llama.cpp (example endpoint) --
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-api-key-if-required

# --- Token budget ---
TOKEN_LIMIT=400000
