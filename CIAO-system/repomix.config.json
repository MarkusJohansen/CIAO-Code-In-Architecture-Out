{
  "input": {
    "max_file_size": 52428800
  },
  "output": {
    "file_path": "full_code.txt",
    "style": "plain",
    "parsable_style": false,
    "file_summary": false,
    "directory_structure": true,
    "files": true,
    "remove_comments": true,
    "remove_empty_lines": true,
    "compress": false,
    "top_files_length": 5,
    "show_line_numbers": false,
    "copy_to_clipboard": false,
    "git": {
      "sort_by_changes": false,
      "sort_by_changes_max_commits": 100,
      "include_diffs": false
    }
  },
  "include": ["**/*.py", "**/*.html", "**/*.css", "**/*.js", "**/*.ipynb", "**/*.pth"],
  "ignore": {
    "use_gitignore": true,
    "custom_patterns": [
      "*.png", "*.jpg", "*.jpeg", "*.gif", "*.svg", "*.pdf",
      "*.jar", "*.exe", "*.dll",
      "node_modules/**/*",
      "build/**/*", "dist/**/*",
      "tests/**/*", "**/Test/**/*"
    ]
  },
  "security": {
    "enable_security_check": true
  },
  "token_count": {
    "encoding": "o200k_base"
  }
}